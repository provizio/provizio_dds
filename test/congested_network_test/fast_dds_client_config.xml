<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com">
    <participant profile_name="participant_discovery_client" is_default_profile="true">
        <rtps>
            <builtin>
                <discovery_config>
                    <discoveryProtocol>CLIENT</discoveryProtocol>
                    <!-- Fast-DDS 3.x simplified the discovery-server schema:
                         the <RemoteServer prefix="..."><metatrafficUnicastLocatorList>...
                         wrapper is gone, the prefix is auto-discovered, and
                         <discoveryServersList> now contains <locator> entries directly. -->
                    <discoveryServersList>
                        <locator>
                            <udpv4>
                                <address>201.10.0.1</address>
                                <port>11811</port>
                            </udpv4>
                        </locator>
                    </discoveryServersList>
                    <clientAnnouncementPeriod>
                        <nanosec>100000000</nanosec>
                    </clientAnnouncementPeriod>
                </discovery_config>
            </builtin>
        </rtps>
    </participant>
</profiles>
