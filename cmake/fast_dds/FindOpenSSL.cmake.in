# FindOpenSSL for the Fast-DDS that provizio_dds builds, generated by provizio_dds's CMakeLists.txt
# when it found OpenSSL as a package: it loads that same package's configuration, so Fast-DDS links
# the OpenSSL provizio_dds found, with the dependencies the configuration names for it (a static
# OpenSSL's zlib, say), rather than whichever OpenSSL a search of its own comes across.
#
# The package it stands for: OpenSSL @OPENSSL_VERSION@, configured by
#   @OpenSSL_CONFIG@
# with its headers in
#   @_OPENSSL_INCLUDE_DIR@
# Another package makes this file another, which makes Fast-DDS configure again.
#
# The configuration finds those dependencies as packages of their own, so the lookup runs with the
# package search settings provizio_dds found OpenSSL with, and in the configuration (build type)
# provizio_dds consumes it in, where Fast-DDS builds in another (but for Fast-DDS built as Release for
# the release CRT, which takes the package's Release configuration). They apply to this lookup alone:
# Fast-DDS's other packages are found as they are without it. The values are bracket arguments, so
# that a path is taken as it is, backslashes and all.

set(_provizio_dds_openssl_args)
if(OpenSSL_FIND_VERSION)
    list(APPEND _provizio_dds_openssl_args "${OpenSSL_FIND_VERSION}")
endif()
list(APPEND _provizio_dds_openssl_args CONFIG PATHS [==[@PROVIZIO_DDS_OPENSSL_CONFIG_DIR@]==] NO_DEFAULT_PATH)
if(OpenSSL_FIND_REQUIRED)
    list(APPEND _provizio_dds_openssl_args REQUIRED)
endif()
if(OpenSSL_FIND_QUIETLY)
    list(APPEND _provizio_dds_openssl_args QUIET)
endif()
if(OpenSSL_FIND_COMPONENTS)
    list(APPEND _provizio_dds_openssl_args COMPONENTS ${OpenSSL_FIND_COMPONENTS})
endif()

set(_provizio_dds_openssl_prefix_path "${CMAKE_PREFIX_PATH}")
set(_provizio_dds_openssl_prefer_config "${CMAKE_FIND_PACKAGE_PREFER_CONFIG}")
set(CMAKE_PREFIX_PATH [==[@PROVIZIO_DDS_OPENSSL_PREFIX_PATH@]==] ${CMAKE_PREFIX_PATH})
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG [==[@CMAKE_FIND_PACKAGE_PREFER_CONFIG@]==])

# The package's imported targets hold what they hold for one configuration: the one provizio_dds
# consumes them in, which Fast-DDS's is mapped to wherever the two differ, when provizio_dds names
# one (not for Fast-DDS built as Release for the release CRT)
set(_provizio_dds_openssl_package_config [==[@PROVIZIO_DDS_OPENSSL_PACKAGE_CONFIG@]==])
string(TOUPPER "${CMAKE_BUILD_TYPE}" _provizio_dds_openssl_build_type)
set(_provizio_dds_openssl_map_var "CMAKE_MAP_IMPORTED_CONFIG_${_provizio_dds_openssl_build_type}")
set(_provizio_dds_openssl_mapped FALSE)
if(_provizio_dds_openssl_package_config AND NOT CMAKE_BUILD_TYPE STREQUAL _provizio_dds_openssl_package_config)
    # Put back afterwards as it was, unset included: the targets created later take their mapping
    # from it whenever it is defined, empty or not
    set(_provizio_dds_openssl_mapped TRUE)
    set(_provizio_dds_openssl_map_defined FALSE)
    if(DEFINED ${_provizio_dds_openssl_map_var})
        set(_provizio_dds_openssl_map_defined TRUE)
        set(_provizio_dds_openssl_map "${${_provizio_dds_openssl_map_var}}")
    endif()
    set(${_provizio_dds_openssl_map_var} "${_provizio_dds_openssl_package_config}")
endif()

# Requiring OpenSSL, as provizio_dds has Fast-DDS do, reaches this lookup as its REQUIRED, which a
# CMAKE_REQUIRE_FIND_PACKAGE_OpenSSL left in place would only add a warning to
set(_provizio_dds_openssl_require "${CMAKE_REQUIRE_FIND_PACKAGE_OpenSSL}")
set(CMAKE_REQUIRE_FIND_PACKAGE_OpenSSL FALSE)
find_package(OpenSSL ${_provizio_dds_openssl_args})
set(CMAKE_REQUIRE_FIND_PACKAGE_OpenSSL "${_provizio_dds_openssl_require}")
unset(_provizio_dds_openssl_require)

if(_provizio_dds_openssl_mapped)
    if(_provizio_dds_openssl_map_defined)
        set(${_provizio_dds_openssl_map_var} "${_provizio_dds_openssl_map}")
    else()
        unset(${_provizio_dds_openssl_map_var})
    endif()
endif()
set(CMAKE_PREFIX_PATH "${_provizio_dds_openssl_prefix_path}")
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG "${_provizio_dds_openssl_prefer_config}")
unset(_provizio_dds_openssl_map)
unset(_provizio_dds_openssl_map_defined)
unset(_provizio_dds_openssl_mapped)
unset(_provizio_dds_openssl_map_var)
unset(_provizio_dds_openssl_build_type)
unset(_provizio_dds_openssl_package_config)
unset(_provizio_dds_openssl_prefix_path)
unset(_provizio_dds_openssl_prefer_config)
unset(_provizio_dds_openssl_args)

# Fast-DDS reads the result in upper case, which not every package's configuration sets
set(OPENSSL_FOUND "${OpenSSL_FOUND}")
