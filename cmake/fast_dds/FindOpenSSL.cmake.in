# FindOpenSSL for the Fast-DDS that provizio_dds builds, generated by provizio_dds's CMakeLists.txt
# (provizio_dds_write_openssl_find_module in openssl_package.cmake) when it found OpenSSL as a
# package: it loads that same package's configuration, so Fast-DDS links the OpenSSL provizio_dds
# found, with the dependencies the configuration names for it (a static OpenSSL's zlib, say), rather
# than whichever OpenSSL a search of its own comes across.
#
# The package it stands for: OpenSSL @PROVIZIO_DDS_OPENSSL_VERSION@, configured by
#   @OpenSSL_CONFIG@
# with its headers in
#   @_OPENSSL_INCLUDE_DIR@
# Another package, or other settings below, make this file another, which makes Fast-DDS configure
# again.
#
# The configuration finds those dependencies as packages of their own, so the lookup runs with the
# package search settings provizio_dds found OpenSSL with -- its CMAKE_PREFIX_PATH,
# CMAKE_MODULE_PATH and CMAKE_FIND_PACKAGE_PREFER_CONFIG, and every package location it was given or
# found (a <Package>_DIR holding a package configuration, a <Package>_ROOT) -- and in the
# configuration (build type) provizio_dds consumes it in, where Fast-DDS builds in another (but for
# Fast-DDS built as Release for the release CRT, which takes the package's Release configuration).
# They apply to this lookup alone: it runs in a function, whose variables go with it, and Fast-DDS's
# other packages are found as they are without them. The values are bracket arguments, so that a path
# is taken as it is, backslashes and all.
#
# Nothing the lookup caches outlives it either. This build directory is configured again whenever
# provizio_dds is, and a dependency location cached here by an earlier configure -- a ZLIB_DIR, a
# ZLIB_LIBRARY -- would otherwise win over the one provizio_dds finds now, so that Fast-DDS linked
# another zlib than provizio_dds: the very mismatch this file exists to rule out for OpenSSL.

function(_provizio_dds_find_openssl)
    set(_provizio_dds_openssl_args)
    if(OpenSSL_FIND_VERSION)
        list(APPEND _provizio_dds_openssl_args "${OpenSSL_FIND_VERSION}")
    endif()
    list(APPEND _provizio_dds_openssl_args CONFIG PATHS [==[@PROVIZIO_DDS_OPENSSL_CONFIG_DIR@]==] NO_DEFAULT_PATH)
    if(OpenSSL_FIND_REQUIRED)
        list(APPEND _provizio_dds_openssl_args REQUIRED)
    endif()
    if(OpenSSL_FIND_QUIETLY)
        list(APPEND _provizio_dds_openssl_args QUIET)
    endif()
    if(OpenSSL_FIND_COMPONENTS)
        list(APPEND _provizio_dds_openssl_args COMPONENTS ${OpenSSL_FIND_COMPONENTS})
    endif()

    # provizio_dds's search settings, ahead of this build's own (and nothing, where one is empty)
    set(_provizio_dds_openssl_prefix_path [==[@PROVIZIO_DDS_OPENSSL_PREFIX_PATH@]==])
    list(PREPEND CMAKE_PREFIX_PATH ${_provizio_dds_openssl_prefix_path})
    set(_provizio_dds_openssl_module_path [==[@PROVIZIO_DDS_OPENSSL_MODULE_PATH@]==])
    list(PREPEND CMAKE_MODULE_PATH ${_provizio_dds_openssl_module_path})
    set(CMAKE_FIND_PACKAGE_PREFER_CONFIG [==[@CMAKE_FIND_PACKAGE_PREFER_CONFIG@]==])
    # and its package locations, each a variable here, which a lookup reads ahead of the cache entry
    # of that name, and each named in _provizio_dds_openssl_names
    set(_provizio_dds_openssl_names)
@PROVIZIO_DDS_OPENSSL_LOCATIONS@

    # The package's imported targets hold what they hold for one configuration: the one provizio_dds
    # consumes them in, which Fast-DDS's is mapped to wherever the two differ, when provizio_dds names
    # one (not for Fast-DDS built as Release for the release CRT). Read by the targets as they are
    # created, which is during this lookup.
    set(_provizio_dds_openssl_package_config [==[@PROVIZIO_DDS_OPENSSL_PACKAGE_CONFIG@]==])
    if(_provizio_dds_openssl_package_config AND NOT CMAKE_BUILD_TYPE STREQUAL _provizio_dds_openssl_package_config)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" _provizio_dds_openssl_build_type)
        set(CMAKE_MAP_IMPORTED_CONFIG_${_provizio_dds_openssl_build_type} "${_provizio_dds_openssl_package_config}")
    endif()

    # Requiring OpenSSL, as provizio_dds has Fast-DDS do, reaches this lookup as its REQUIRED, which a
    # CMAKE_REQUIRE_FIND_PACKAGE_OpenSSL left in place would only add a warning to
    set(CMAKE_REQUIRE_FIND_PACKAGE_OpenSSL FALSE)

    get_cmake_property(_provizio_dds_openssl_variables_before VARIABLES)
    get_cmake_property(_provizio_dds_openssl_cache_before CACHE_VARIABLES)
    find_package(OpenSSL ${_provizio_dds_openssl_args})
    get_cmake_property(_provizio_dds_openssl_variables_after VARIABLES)
    get_cmake_property(_provizio_dds_openssl_cache_after CACHE_VARIABLES)

    # What the lookup found, for the caller: every variable it defined, but the settings above and the
    # cache entries removed below
    foreach(_provizio_dds_openssl_variable IN LISTS _provizio_dds_openssl_variables_after)
        if(NOT _provizio_dds_openssl_variable IN_LIST _provizio_dds_openssl_variables_before
                AND NOT _provizio_dds_openssl_variable IN_LIST _provizio_dds_openssl_names
                AND NOT _provizio_dds_openssl_variable IN_LIST _provizio_dds_openssl_cache_after
                AND NOT _provizio_dds_openssl_variable MATCHES "^_provizio_dds_openssl_")
            set(${_provizio_dds_openssl_variable} "${${_provizio_dds_openssl_variable}}" PARENT_SCOPE)
        endif()
    endforeach()
    # ...and nothing of it for the next configure (see the top of this file)
    foreach(_provizio_dds_openssl_entry IN LISTS _provizio_dds_openssl_cache_after)
        if(NOT _provizio_dds_openssl_entry IN_LIST _provizio_dds_openssl_cache_before)
            unset(${_provizio_dds_openssl_entry} CACHE)
        endif()
    endforeach()
endfunction()

_provizio_dds_find_openssl()

# Fast-DDS reads the result, and the version for its report, in upper case, which not every package's
# configuration sets
set(OPENSSL_FOUND "${OpenSSL_FOUND}")
if(NOT DEFINED OPENSSL_VERSION AND DEFINED OpenSSL_VERSION)
    set(OPENSSL_VERSION "${OpenSSL_VERSION}")
endif()
