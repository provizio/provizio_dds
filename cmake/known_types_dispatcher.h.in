#ifndef PROVIZIO_DDS_KNOWN_TYPES_DISPATCHER_H
#define PROVIZIO_DDS_KNOWN_TYPES_DISPATCHER_H

#include <string>
#include <utility>

#include "provizio/dds/common.h"

@KNOWN_TYPES_INCLUDES@

namespace provizio::dds
{
    namespace detail
    {
        /**
         * @brief Cached wire-format type name (e.g. @c "std_msgs::msg::dds_::String_")
         * for a @c data_pub_sub_type. Computed once per type by constructing
         * an instance and calling @c get_name(); the cached reference is
         * returned on subsequent calls.
         *
         * Used by @c visit_known_type's generated dispatch table to avoid
         * constructing a PubSubType per discovery event just to recover its
         * wire name. The wire name is what @c on_discovered_endpoint hands
         * over and what the type-name strings compare against; the C++ class
         * name (e.g. @c std_msgs::msg::StringPubSubType ) is unrelated and
         * not derivable by a simple textual transform (notably for service
         * types where one header declares both @c Foo_RequestPubSubType and
         * @c Foo_ResponsePubSubType ).
         */
        template <typename data_pub_sub_type> const std::string &known_type_wire_name()
        {
            static const std::string name = [] {
                data_pub_sub_type instance;
                return std::string{instance.get_name()};
            }();
            return name;
        }
    }  // namespace detail

    /**
     * @brief Compile-time dispatch over the @c provizio_dds_idls type catalogue.
     *
     * If @p type_name matches one of the known PubSubType wire names, invoke
     * @p v 's templated @c operator() once with the matched
     * @c data_pub_sub_type and return @c true. Otherwise return @c false
     * without invoking the visitor.
     *
     * Intended companion to @c on_discovered_endpoint and @c is_known_type :
     * the recorder gets a @c (topic_name, type_name) pair from discovery and
     * wants to construct a typed Publisher / Subscriber / forwarder pair for
     * it without compile-time-fixing the type. Write the typed body once
     * (a templated @c operator() that compiles for any @c PubSubType ), and
     * the generated dispatcher below routes the runtime type-name string to
     * the right instantiation. Adding a new IDL to @c provizio_dds_idls
     * regenerates this header at the next CMake configure — the visitor's
     * body is instantiated for the new type automatically, no caller code
     * change needed.
     *
     * @code{.cpp}
     * struct announce_factory {
     *     std::shared_ptr<provizio::dds::domain_participant> participant;
     *     std::string topic_name;
     *     std::shared_ptr<void> result;
     *
     *     template <typename data_pub_sub_type>
     *     void operator()() {
     *         result = provizio::dds::make_publisher<data_pub_sub_type>(
     *             participant, topic_name,
     *             provizio::dds::BEST_EFFORT_RELIABILITY_QOS);
     *     }
     * };
     *
     * announce_factory v{participant, topic_name, {}};
     * if (provizio::dds::visit_known_type(type_name, v)) {
     *     // v.result holds a typed publisher_handle<...> erased into shared_ptr<void>.
     * }
     * @endcode
     *
     * @note Including this header pulls in every @c *PubSubTypes.hpp shipped
     * by @c provizio_dds_idls — the cost is paid only by translation units
     * that opt into the dispatcher.
     *
     * @note The visitor is taken by forwarding reference so non-copyable /
     * state-carrying visitors work. The visitor's @c operator() is
     * instantiated once per known type in the calling translation unit; the
     * runtime dispatch picks one branch per call.
     *
     * @param type_name  Wire-format type name (e.g. @c "std_msgs::msg::dds_::String_")
     *                   — exactly as delivered by @c on_discovered_endpoint.
     * @param v          Visitor whose @c operator() is a function template
     *                   over @c data_pub_sub_type . Invoked at most once per
     *                   call to @c visit_known_type .
     * @return @c true if @p type_name matched a known type and the visitor
     *         was invoked; @c false otherwise.
     */
    template <typename visitor> bool visit_known_type(const std::string &type_name, visitor &&v)
    {
@KNOWN_TYPES_DISPATCH_BRANCHES@
        return false;
    }
}  // namespace provizio::dds

#endif  // PROVIZIO_DDS_KNOWN_TYPES_DISPATCHER_H
